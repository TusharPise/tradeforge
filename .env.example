# ==============================================================================
# TradeForge - Environment Variables Template
# Copy this file to .env and replace placeholders with your local credentials.
# ==============================================================================

# Database Connection (PostgreSQL 18)
# Replace <PASSWORD> with your local postgres user password
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/tradeforge"

# Backend API Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=TradeForge

# Security
JWT_SECRET="<YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARS>"
